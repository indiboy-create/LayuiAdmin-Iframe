{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "msedge",
			"request": "launch",
			"name": "调试 MyTSA (Edge)",
			"url": "http://localhost:5173/login.html",
			"webRoot": "${workspaceFolder}/src",
			"runtimeArgs": ["--remote-allow-origins=*"],
			"preLaunchTask": "vite:dev"
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "调试 MyTSA (Chrome)",
			"url": "http://localhost:5173/login.html",
			"webRoot": "${workspaceFolder}/src",
			"runtimeArgs": ["--remote-allow-origins=*"],
			"preLaunchTask": "vite:dev"
		},
		{
			"type": "msedge",
			"request": "launch",
			"name": "调试 MyTSA (复用已运行的 dev server)",
			"url": "http://localhost:5173/login.html",
			"webRoot": "${workspaceFolder}/src",
			"runtimeArgs": ["--remote-allow-origins=*"]
		}
	]
}
