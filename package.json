{
	"name": "@indiboy-create/layuiadmin-iframe",
	"version": "1.0.0",
	"type": "module",
	"description": "LayuiAdmin-Iframe - 基于 Layui 的后台管理系统前端模板",
	"keywords": [
		"layui",
		"admin",
		"iframe",
		"template",
		"dashboard"
	],
	"author": "indiboy-create",
	"license": "MIT",
	"homepage": "https://indiboy-create.github.io/LayuiAdmin-Iframe/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/indiboy-create/LayuiAdmin-Iframe.git"
	},
	"bugs": {
		"url": "https://github.com/indiboy-create/LayuiAdmin-Iframe/issues"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "node scripts/build.mjs",
		"build:debug": "node scripts/build.mjs --no-minify",
		"preview": "vite preview",
		"check": "node scripts/check.mjs",
		"check:release": "node scripts/check.mjs --strict-debug",
		"test": "node --test test/smoke.test.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"*.config.js\" \".github/workflows/*.yml\"",
		"prepublishOnly": "node scripts/check.mjs",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"clean-css": "^5.3.3",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"terser": "^5.51.2",
		"vite": "^8.3.5"
	}
}
