{
	"name": "@indiboy-create/layuiadmin-iframe",
	"version": "1.0.0",
	"type": "module",
	"description": "LayuiAdmin-Iframe - 基于 Layui 的后台管理系统前端模板",
	"keywords": [
		"layui",
		"admin",
		"iframe",
		"template",
		"dashboard"
	],
	"author": "indiboy-create",
	"license": "MIT",
	"homepage": "https://initearth.github.io/LayuiAdmin-Iframe/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/initearth/LayuiAdmin-Iframe.git"
	},
	"bugs": {
		"url": "https://github.com/initearth/LayuiAdmin-Iframe/issues"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "node scripts/build.mjs",
		"build:debug": "node scripts/build.mjs --no-minify",
		"build:all": "npm run build && npm run build:debug",
		"preview": "vite preview",
		"check": "node scripts/check.mjs",
		"check:debug": "node scripts/check.mjs --dir=dist-debug",
		"check:release": "node scripts/check.mjs --strict-debug",
		"e2e": "node scripts/e2e.mjs",
		"test": "node --test test/smoke.test.mjs test/build.test.mjs test/sanitize.test.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"*.config.js\" \".github/workflows/*.yml\"",
		"prepublishOnly": "npm run build && npm run check:release",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"clean-css": "^5.3.3",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"html-minifier-terser": "^7.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"terser": "^5.51.2",
		"vite": "^8.3.5"
	}
}
