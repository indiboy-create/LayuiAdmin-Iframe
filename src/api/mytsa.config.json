{
	"site": {
		"scope": "default"
	},
	"logo": {
		"title": "MyTSA",
		"image": "theme/admin/images/logo.webp"
	},
	"menu": {
		"data": "api/menu.json",
		"method": "GET",
		"accordion": true,
		"collapse": false,
		"select": "10",
